import os
import sys
from pathlib import Path

from app.agent import JarvisAgent
from app.memory import MemoryStore
from app.tools import ToolBox


def print_banner() -> None:
    print("JARVIS - Local Linux Terminal Assistant")
    print("Type !help for commands. Type exit to quit.\n")


def confirm_execution(command: str) -> bool:
    answer = input(f"Run this command?\n{command}\n[y/N]: ").strip().lower()
    return answer in {"y", "yes"}


def main() -> None:
    memory = MemoryStore()
    agent = JarvisAgent(memory)
    tools = ToolBox()
    print_banner()

    while True:
        try:
            user_input = input("you> ")
        except KeyboardInterrupt:
            print("\nGoodbye.")
            break

        text = user_input.strip()
        if not text:
            continue

        if text.lower() in {"exit", "quit"}:
            print("Goodbye.")
            break

        if text.lower() == "!clear":
            memory.clear()
            print("Memory cleared.")
            continue

        if text.lower() == "!help":
            print("Commands:")
            print("  !help          Show this help")
            print("  !ls [path]     List a directory")
            print("  !read <path>   Read a file")
            print("  !write <path>  Write a file")
            print("  !run <cmd>     Run a shell command after confirmation")
            print("  !sys           Show system info")
            print("  !clear        Clear memory")
            print("  exit           Quit")
            continue

        if text.lower().startswith("!ls"):
            path = text[4:].strip() or "."
            print(tools.list_directory(path))
            continue

        if text.lower().startswith("!read "):
            path = text[6:].strip()
            print(tools.read_file(path))
            continue

        if text.lower().startswith("!write "):
            parts = text.split(maxsplit=2)
            if len(parts) < 3:
                print("Usage: !write <path> <content>")
                continue
            path = parts[1]
            content = parts[2]
            print(tools.write_file(path, content))
            continue

        if text.lower().startswith("!run "):
            command = text[5:].strip()
            if not command:
                print("Usage: !run <shell command>")
                continue
            if confirm_execution(command):
                print(tools.run_command(command))
            else:
                print("Command not executed.")
            continue

        if text.lower() == "!sys":
            print(tools.get_system_info())
            continue

        response = agent.chat(text)
        print(f"JARVIS> {response}\n")


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        pass
    except Exception as exc:
        print(f"Fatal error: {exc}", file=sys.stderr)
        sys.exit(1)
