import os
from dataclasses import dataclass
from pathlib import Path


@dataclass
class AgentConfig:
    github_token: str
    target_repo: str
    poll_interval_seconds: int = 60
    output_dir: str = "out"
    copilot_api_token: str | None = None
    copilot_api_base_url: str = "https://api.githubcopilot.com"
    copilot_model: str = "gpt-4o"

    @classmethod
    def from_env(
        cls,
        repo_override: str | None = None,
        interval_override: int | None = None,
        output_dir_override: str | None = None,
        model_override: str | None = None,
    ) -> "AgentConfig":
        github_token = os.getenv("GITHUB_TOKEN") or ""
        if not github_token:
            raise ValueError("GITHUB_TOKEN must be set to query GitHub data.")

        repo_name = repo_override or os.getenv("TARGET_GITHUB_REPO") or "owner/repo"
        if "/" not in repo_name:
            raise ValueError("TARGET_GITHUB_REPO must be in the format 'owner/repo'.")

        interval = interval_override if interval_override is not None else int(os.getenv("POLL_INTERVAL_SECONDS", "60"))
        output_dir = output_dir_override or os.getenv("OUTPUT_DIR", "out")
        copilot_token = os.getenv("COPILOT_API_TOKEN") or None
        copilot_base = os.getenv("COPILOT_API_BASE_URL", "https://api.githubcopilot.com")
        copilot_model = model_override or os.getenv("COPILOT_MODEL", "gpt-4o")

        return cls(
            github_token=github_token,
            target_repo=repo_name,
            poll_interval_seconds=max(10, interval),
            output_dir=output_dir,
            copilot_api_token=copilot_token,
            copilot_api_base_url=copilot_base,
            copilot_model=copilot_model,
        )

    def ensure_output_dir(self) -> Path:
        path = Path(self.output_dir)
        path.mkdir(parents=True, exist_ok=True)
        return path
